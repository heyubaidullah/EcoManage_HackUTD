# ─────────────────────────────────────────────────────────────────────────────
#  EcoManage — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── FOR REPLIT & LOCAL (Python/Flask backend) ─────────────────────────────────
#
# PostgreSQL connection string.
#
#   Replit:      injected automatically — no action needed.
#
#   Local PostgreSQL:
#     DATABASE_URL=postgresql://postgres:password@localhost:5432/ecomanage
#
#   Supabase (recommended for local dev without a local Postgres):
#     1. Go to https://supabase.com → New project
#     2. Settings → Database → Connection string → URI tab
#     3. Paste the URI below (replace [YOUR-PASSWORD])
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres


# ── FOR NETLIFY DEPLOYMENT (Netlify Function backend) ─────────────────────────
#
# The Netlify Function (netlify/functions/api.js) connects to Supabase
# using these two values. Set them in:
#   Netlify Dashboard → Site → Environment variables
#
#   SUPABASE_URL:              Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role (secret)
#
# The service_role key bypasses Row Level Security — keep it server-side only.
# It is safe here because it only lives in the Netlify Function environment,
# never shipped to the browser.
#
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
