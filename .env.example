# ─────────────────────────────────────────────────────────────
#  EcoManage — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────
# PostgreSQL connection string.
#
#   Local PostgreSQL:
#     DATABASE_URL=postgresql://postgres:password@localhost:5432/ecomanage
#
#   Supabase (free tier — recommended for non-Replit deployments):
#     1. Go to https://supabase.com → New project
#     2. Settings → Database → Connection string → URI tab
#     3. Paste the URI below (replace [YOUR-PASSWORD])
#
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── NETLIFY FRONTEND → BACKEND PROXY ─────────────────────────
# The public URL of your deployed Flask backend.
# Set this in the Netlify dashboard under Site → Environment variables.
#
#   Render.com example:  https://ecomanage-api.onrender.com
#   Railway example:     https://ecomanage-api.up.railway.app
#
# This is used by scripts/build-netlify.sh to generate _redirects.
# Not needed for Replit or local development.
#
ECOMANAGE_API_URL=https://your-backend.onrender.com
